{
  "id": "aurora",
  "name": "Aurora",
  "category": "Gradient",
  "description": "Deep navy with glowing color fields that flow across the whole set.",
  "canvas": {
    "width": 1080,
    "height": 1920
  },
  "theme": {
    "background": "#0D1033",
    "foreground": "#FFFFFF",
    "primary": "#4F6BFF",
    "accent": "#FF5FA2",
    "surface": "#1C2155"
  },
  "editableColors": [
    "background",
    "primary",
    "accent"
  ],
  "background": {
    "type": "solid",
    "color": "$background"
  },
  "grain": 0.08,
  "overrides": {
    "shot": {
      "shadow": {
        "y": 50,
        "blur": 110,
        "color": "rgba(0, 0, 0, 0.55)"
      }
    },
    "shot-back": {
      "shadow": {
        "y": 40,
        "blur": 90,
        "color": "rgba(0, 0, 0, 0.5)"
      }
    }
  },
  "panorama": [
    {
      "type": "shape",
      "id": "glow-1",
      "shape": "circle",
