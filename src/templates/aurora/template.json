      "y": 860,
      "width": 1050,
      "height": 1050,
      "fill": "$primary",
      "blur": 160,
      "opacity": 0.85
    },
    {
      "type": "shape",
      "id": "glow-2",
      "shape": "circle",
      "x": 660,
      "y": -180,
      "width": 900,
      "height": 900,
      "fill": "$accent",
      "blur": 160,
      "opacity": 0.7
    },
    {
      "type": "shape",
