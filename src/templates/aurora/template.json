      "fill": "#7B5CFF",
      "blur": 160,
      "opacity": 0.8
    },
    {
      "type": "shape",
      "id": "glow-4",
      "shape": "circle",
      "x": 2780,
      "y": -120,
      "width": 920,
      "height": 920,
      "fill": "$primary",
      "blur": 160,
      "opacity": 0.75
