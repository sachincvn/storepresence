  "slides": [
    {
      "layout": "badge-hero",
      "defaults": {
        "badge": "New: Smart lists",
        "headline": "Plan your day in **seconds**",
        "description": "Every task sorted by what matters most."
      },
      "overrides": {
        "badge": {
          "color": "$foreground",
          "pill": {
            "fill": "rgba(255, 255, 255, 0.12)",
