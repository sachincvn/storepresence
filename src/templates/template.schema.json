          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "layer": {
          "description": "Extra elements default to \"back\" (behind layout elements).",
          "enum": [
            "back",
            "front"
          ],
          "type": "string"
        },
        "opacity": {
          "description": "0–1",
          "type": "number"
        },
        "radius": {
          "type": "number"
        },
        "rotation": {
