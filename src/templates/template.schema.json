        },
        "type": {
          "const": "image",
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "fit",
        "height",
        "id",
        "src",
        "type",
        "width",
        "x",
        "y"
      ],
      "type": "object"
    },
    "ImageSlotElement": {
      "additionalProperties": false,
      "description": "A spot for the user's own image (app icon, logo, mascot). Empty slots draw nothing, or a monogram tile when `monogram` is set (good for app icons).",
      "properties": {
        "fit": {
          "$ref": "#/definitions/FitMode"
        },
        "height": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "$ref": "#/definitions/ImageSlotKey"
        },
        "layer": {
          "description": "Extra elements default to \"back\" (behind layout elements).",
          "enum": [
            "back",
            "front"
          ],
          "type": "string"
        },
        "monogram": {
          "additionalProperties": false,
          "description": "Fallback tile: first letter of `text` on `fill`.",
          "properties": {
            "color": {
              "$ref": "#/definitions/Color"
            },
            "fill": {
              "$ref": "#/definitions/Color"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text",
            "fill",
            "color"
          ],
          "type": "object"
        },
        "opacity": {
          "description": "0–1",
          "type": "number"
        },
        "radius": {
          "type": "number"
        },
