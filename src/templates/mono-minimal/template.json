{
  "id": "mono-minimal",
  "name": "Mono Minimal",
  "category": "Minimal",
  "description": "Black, white and nothing else. Huge two-tone type does the talking.",
  "canvas": {
    "width": 1080,
    "height": 1920
  },
  "theme": {
    "background": "#FFFFFF",
    "foreground": "#0A0A0A",
    "primary": "#0A0A0A",
    "accent": "#71717A",
    "surface": "#F4F4F5"
  },
  "editableColors": [
    "background",
    "foreground"
  ],
  "background": {
    "type": "solid",
    "color": "$background"
  },
  "overrides": {
    "headline": {
      "font": "sans",
      "weight": 800,
      "letterSpacing": -0.045,
      "emphasis": {
        "color": "$accent"
      },
      "marker": "#E4E4E7"
    },
    "shot": {
      "device": "phone-island",
      "frameColor": "#0A0A0A",
      "shadow": {
        "y": 30,
        "blur": 60,
        "color": "rgba(0, 0, 0, 0.14)"
      }
    }
  },
  "slides": [
    {
      "layout": "phone-center",
      "defaults": {
        "headline": "Plan your day in **seconds**",
        "description": "Every task sorted by what matters most."
      }
    },
    {
      "layout": "zoom",
      "defaults": {
        "headline": "See your progress ==grow==",
        "description": "Clear stats that keep you going."
      }
    },
    {
      "layout": "text-bottom",
      "defaults": {
        "headline": "Stay in sync with your **team**",
        "description": "Chat and share without switching apps."
      }
    },
    {
      "layout": "pop-out",
      "defaults": {
        "headline": "Never miss a ==deadline==",
        "description": "Smart reminders, right on time."
      },
      "background": {
        "type": "solid",
        "color": "$foreground"
      },
      "overrides": {
        "headline": {
          "color": "$background",
          "emphasis": {
            "color": "#A1A1AA"
          },
          "marker": "#3F3F46"
        },
        "description": {
          "color": "$background"
        },
        "shot": {
          "frameColor": "#27272A",
          "shadow": {
            "y": 40,
            "blur": 90,
            "color": "rgba(0, 0, 0, 0.6)"
          }
        },
        "callout": {
          "region": {
            "x": 0.03,
            "y": 0.622,
            "w": 0.94,
            "h": 0.087
          },
          "radius": 36,
          "shadow": {
            "y": 30,
            "blur": 80,
            "color": "rgba(0, 0, 0, 0.7)"
          }
        }
      }
    }
  ]
}
