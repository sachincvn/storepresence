{
  "id": "sunny-pop",
  "name": "Sunny Pop",
  "category": "Bold",
  "description": "Warm sunshine yellow with soft light, bold type and floating cards.",
  "canvas": {
    "width": 1080,
    "height": 1920
  },
  "theme": {
    "background": "#FFD43B",
    "foreground": "#16131F",
    "primary": "#16131F",
    "accent": "#FF6FAE",
    "surface": "#FFFFFF"
  },
  "editableColors": [
    "background",
    "accent"
  ],
  "background": {
    "type": "linear",
    "angle": 180,
    "stops": [
      {
        "color": "#FFE57A",
        "at": 0
      },
      {
        "color": "$background",
        "at": 0.55
      },
      {
        "color": "#FFC21A",
        "at": 1
      }
    ]
  },
  "grain": 0.05,
  "overrides": {
    "shot": {
      "shadow": {
        "x": 22,
        "y": 22,
        "blur": 0,
        "color": "#16131F"
      }
    },
    "shot-back": {
      "shadow": {
        "x": 22,
        "y": 22,
        "blur": 0,
        "color": "#16131F"
      }
    },
    "headline": {
      "letterSpacing": -0.045
    },
    "badge": {
      "color": "$background",
      "pill": {
        "fill": "$foreground",
        "paddingX": 36,
        "paddingY": 20
      }
    }
  },
  "slides": [
    {
      "layout": "text-bottom",
      "defaults": {
        "headline": "Plan your day in **seconds**",
        "description": "Every task sorted by what matters most."
      }
    },
    {
      "layout": "badge-hero",
      "defaults": {
        "badge": "Weekly insights",
        "headline": "See your progress ==grow==",
        "description": "Clear stats that keep you going."
      },
      "overrides": {
        "headline": {
          "emphasis": {
            "color": "$background"
          },
          "marker": "$background"
        }
      }
    },
    {
      "layout": "duo",
      "defaults": {
        "headline": "Stay in sync with your **team**",
        "description": "Chat and share without switching apps."
      }
    },
    {
      "layout": "zoom",
      "defaults": {
        "headline": "Never miss a ==deadline==",
        "description": "Smart reminders, right on time."
      }
    }
  ],
  "panorama": [
    {
      "type": "shape",
      "id": "light-1",
      "shape": "circle",
      "x": 120,
      "y": -420,
      "width": 1000,
      "height": 1000,
      "fill": "#FFFFFF",
      "blur": 200,
      "opacity": 0.55
    },
    {
      "type": "shape",
      "id": "rose-1",
      "shape": "circle",
      "x": 820,
      "y": 1300,
      "width": 920,
      "height": 920,
      "fill": "$accent",
      "blur": 220,
      "opacity": 0.3
    },
    {
      "type": "shape",
      "id": "light-2",
      "shape": "circle",
      "x": 2120,
      "y": -360,
      "width": 980,
      "height": 980,
      "fill": "#FFFFFF",
      "blur": 200,
      "opacity": 0.5
    },
    {
      "type": "shape",
      "id": "rose-2",
      "shape": "circle",
      "x": 3100,
      "y": 1240,
      "width": 960,
      "height": 960,
      "fill": "$accent",
      "blur": 220,
      "opacity": 0.26
    },
    {
      "type": "shape",
      "id": "ring-1",
      "shape": "circle",
      "x": 1520,
      "y": 900,
      "width": 1400,
      "height": 1400,
      "fill": "transparent",
      "stroke": {
        "color": "rgba(22,19,31,0.08)",
        "width": 3
      }
    }
  ]
}
