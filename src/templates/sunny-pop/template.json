{
  "id": "sunny-pop",
  "name": "Sunny Pop",
  "category": "Bold",
  "description": "Loud pop colors, hard shadows and halftone dots.",
  "canvas": {
    "width": 1080,
    "height": 1920
  },
  "theme": {
    "background": "#FFD43B",
    "foreground": "#16131F",
    "primary": "#16131F",
    "accent": "#FF6FAE",
    "surface": "#FFFFFF"
  },
  "editableColors": [
    "background",
    "accent"
  ],
  "background": {
    "type": "solid",
    "color": "$background"
  },
  "overrides": {
    "shot": {
      "shadow": {
        "x": 22,
        "y": 22,
        "blur": 0,
        "color": "#16131F"
      }
    },
    "shot-back": {
      "shadow": {
        "x": 22,
        "y": 22,
        "blur": 0,
        "color": "#16131F"
      }
    },
    "headline": {
      "letterSpacing": -0.045
    },
    "badge": {
      "color": "$background",
      "pill": {
        "fill": "$foreground",
        "paddingX": 36,
        "paddingY": 20
      }
    }
  },
  "slides": [
    {
      "layout": "text-bottom",
      "defaults": {
        "headline": "Plan your day in **seconds**",
        "description": "Every task sorted by what matters most."
      },
      "elements": [
        {
          "type": "shape",
          "id": "dots",
          "shape": "circle",
          "x": 620,
          "y": -260,
          "width": 720,
          "height": 720,
          "fill": "#16131F",
          "style": "halftone",
          "opacity": 0.2
        },
        {
          "type": "shape",
          "id": "ring",
          "shape": "circle",
          "x": -140,
          "y": 1080,
          "width": 400,
          "height": 400,
          "fill": "transparent",
          "stroke": {
            "color": "#16131F",
            "width": 10
          }
        }
      ]
    },
    {
      "layout": "badge-hero",
      "defaults": {
        "badge": "Weekly insights",
        "headline": "See your progress ==grow==",
        "description": "Clear stats that keep you going."
      },
      "background": {
        "type": "solid",
        "color": "$accent"
      },
      "elements": [
        {
          "type": "shape",
          "id": "dots",
          "shape": "circle",
          "x": -260,
          "y": 1100,
          "width": 760,
          "height": 760,
          "fill": "#FFFFFF",
          "style": "halftone",
          "opacity": 0.35
        }
      ],
      "overrides": {
        "headline": {
          "emphasis": {
            "color": "$background"
          },
          "marker": "$background"
        }
      }
    },
    {
      "layout": "duo",
      "defaults": {
        "headline": "Stay in sync with your **team**",
        "description": "Chat and share without switching apps."
      },
      "elements": [
        {
          "type": "shape",
          "id": "ring",
          "shape": "circle",
          "x": 760,
          "y": 1460,
          "width": 440,
          "height": 440,
          "fill": "transparent",
          "stroke": {
            "color": "#16131F",
            "width": 10
          }
        },
        {
          "type": "shape",
          "id": "dots",
          "shape": "circle",
          "x": -200,
          "y": -200,
          "width": 600,
          "height": 600,
          "fill": "#16131F",
          "style": "halftone",
          "opacity": 0.18
        }
      ]
    },
    {
      "layout": "zoom",
      "defaults": {
        "headline": "Never miss a ==deadline==",
        "description": "Smart reminders, right on time."
      },
      "background": {
        "type": "solid",
        "color": "#A7C7FF"
      },
      "elements": [
        {
          "type": "shape",
          "id": "dot",
          "shape": "circle",
          "x": -50,
          "y": 1600,
          "width": 240,
          "height": 240,
          "fill": "$accent",
          "stroke": {
            "color": "#16131F",
            "width": 10
          }
        }
      ]
    }
  ]
}
