{
  "id": "duo",
  "canvas": {
    "width": 1080,
    "height": 1920
  },
  "variables": [
    {
      "key": "headline",
      "label": "Headline",
      "default": "Your app, beautifully presented",
      "perSlide": true,
      "maxLength": 48
    },
    {
      "key": "description",
      "label": "Description",
      "default": "",
      "perSlide": true,
      "multiline": true,
      "maxLength": 90
    }
  ],
  "elements": [
    {
      "type": "text",
      "id": "headline",
      "text": "{{headline}}",
      "font": "display",
      "size": 98,
      "minSize": 68,
      "weight": 800,
      "lineHeight": 1,
      "letterSpacing": -0.035,
      "align": "center",
      "verticalAlign": "bottom",
      "color": "$foreground",
      "maxLines": 2,
      "x": 80,
      "y": 130,
      "width": 920,
      "height": 290
    },
    {
      "type": "text",
      "id": "description",
      "text": "{{description}}",
      "font": "sans",
      "size": 38,
      "minSize": 30,
      "weight": 500,
      "lineHeight": 1.32,
      "align": "center",
      "verticalAlign": "top",
      "color": "$foreground",
      "opacity": 0.78,
      "maxLines": 2,
      "x": 140,
      "y": 444,
      "width": 800,
      "height": 104
    },
    {
      "type": "screenshot",
      "id": "shot-back",
      "slot": 1,
      "fit": "cover",
      "align": "top",
      "device": "phone",
      "placeholderColor": "$surface",
      "shadow": {
        "y": 40,
        "blur": 80,
        "color": "rgba(22, 19, 31, 0.28)"
      },
      "x": 60,
      "y": 760,
      "width": 560,
      "height": 1215,
      "radius": 54,
      "rotation": -9
    },
    {
      "type": "screenshot",
      "id": "shot",
      "slot": 0,
      "fit": "cover",
      "align": "top",
      "device": "phone",
      "placeholderColor": "$surface",
      "shadow": {
        "y": 50,
        "blur": 100,
        "color": "rgba(22, 19, 31, 0.35)"
      },
      "x": 430,
      "y": 660,
      "width": 610,
      "height": 1325,
      "radius": 60,
      "rotation": 5
    }
  ]
}
