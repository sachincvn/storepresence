{
  "id": "intro",
  "canvas": {
    "width": 1080,
    "height": 1920
  },
  "variables": [
    {
      "key": "appName",
      "label": "App name",
      "default": "Taskly",
      "maxLength": 24
    },
    {
      "key": "headline",
      "label": "Headline",
      "default": "Your app, beautifully presented",
      "perSlide": true,
      "maxLength": 48
    },
    {
      "key": "ratingScore",
      "label": "Rating",
      "default": "4.9",
      "maxLength": 4
    },
    {
      "key": "ratingLabel",
      "label": "Rating label",
      "default": "120K ratings",
      "maxLength": 24
    },
    {
      "key": "laurelTitle",
      "label": "Award title",
      "default": "Loved by millions",
      "maxLength": 24
    },
    {
      "key": "laurelSubtitle",
      "label": "Award subtitle",
      "default": "Top rated",
      "maxLength": 28
    }
  ],
  "elements": [
    {
      "type": "imageSlot",
      "id": "app-icon",
      "key": "appIcon",
      "x": 380,
      "y": 400,
      "width": 320,
      "height": 320,
      "radius": 76,
      "fit": "cover",
      "shadow": {
        "y": 24,
        "blur": 50,
        "color": "rgba(22, 19, 31, 0.3)"
      },
      "monogram": {
        "text": "{{appName}}",
        "fill": "$accent",
        "color": "#FFFFFF"
      }
    },
    {
      "type": "text",
      "id": "app-name",
      "text": "{{appName}}",
      "font": "display",
      "align": "center",
      "color": "$foreground",
      "x": 90,
      "y": 770,
      "width": 900,
      "height": 110,
      "size": 84,
      "minSize": 56,
      "weight": 800,
      "letterSpacing": -0.035,
      "verticalAlign": "middle",
      "maxLines": 1
    },
    {
      "type": "text",
      "id": "headline",
      "text": "{{headline}}",
      "font": "display",
      "align": "center",
      "color": "$foreground",
      "x": 80,
      "y": 900,
      "width": 920,
      "height": 250,
      "size": 92,
      "minSize": 64,
      "weight": 700,
      "lineHeight": 1.02,
      "letterSpacing": -0.035,
      "verticalAlign": "top",
      "maxLines": 2
    },
    {
      "type": "rating",
      "id": "rating",
      "x": 140,
      "y": 1190,
      "width": 800,
      "height": 64,
      "score": "{{ratingScore}}",
      "label": "{{ratingLabel}}",
      "color": "$foreground",
      "starColor": "$foreground"
    },
    {
      "type": "laurels",
      "id": "laurels",
      "x": 170,
      "y": 1380,
      "width": 740,
      "height": 320,
      "title": "{{laurelTitle}}",
      "subtitle": "{{laurelSubtitle}}",
      "stars": true,
      "color": "$foreground"
    }
  ]
}
