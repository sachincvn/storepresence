{
  "id": "statement",
  "canvas": {
    "width": 1080,
    "height": 1920
  },
  "variables": [
    {
      "key": "appName",
      "label": "App name",
      "default": "Taskly",
      "maxLength": 24
    },
    {
      "key": "headline",
      "label": "Headline",
      "default": "Your app, beautifully presented",
      "perSlide": true,
      "maxLength": 48
    },
    {
      "key": "description",
      "label": "Description",
      "default": "",
      "perSlide": true,
      "multiline": true,
      "maxLength": 90
    }
  ],
  "elements": [
    {
      "type": "imageSlot",
      "id": "app-icon",
      "key": "appIcon",
      "x": 470,
      "y": 340,
      "width": 140,
      "height": 140,
      "radius": 34,
      "fit": "cover",
      "shadow": {
        "y": 24,
        "blur": 50,
        "color": "rgba(22, 19, 31, 0.3)"
      },
      "monogram": {
        "text": "{{appName}}",
        "fill": "$accent",
        "color": "#FFFFFF"
      }
    },
    {
      "type": "text",
      "id": "headline",
      "text": "{{headline}}",
      "font": "display",
      "align": "center",
      "color": "$foreground",
      "x": 80,
      "y": 600,
      "width": 920,
      "height": 640,
      "size": 140,
      "minSize": 88,
      "weight": 800,
      "lineHeight": 0.98,
      "letterSpacing": -0.04,
      "verticalAlign": "middle",
      "maxLines": 4
    },
    {
      "type": "text",
      "id": "description",
      "text": "{{description}}",
      "font": "sans",
      "align": "center",
      "color": "$foreground",
      "x": 140,
      "y": 1280,
      "width": 800,
      "height": 160,
      "size": 44,
      "minSize": 34,
      "weight": 500,
      "lineHeight": 1.32,
      "verticalAlign": "top",
      "opacity": 0.78,
      "maxLines": 3
    }
  ]
}
