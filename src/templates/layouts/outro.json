{
  "id": "outro",
  "canvas": {
    "width": 1080,
    "height": 1920
  },
  "variables": [
    {
      "key": "headline",
      "label": "Headline",
      "default": "Your app, beautifully presented",
      "perSlide": true,
      "maxLength": 48
    },
    {
      "key": "appName",
      "label": "App name",
      "default": "Taskly",
      "maxLength": 24
    },
    {
      "key": "ctaLabel",
      "label": "Button text",
      "default": "Download free",
      "maxLength": 24
    },
    {
      "key": "ratingScore",
      "label": "Rating",
      "default": "4.9",
      "maxLength": 4
    },
    {
      "key": "ratingLabel",
      "label": "Rating label",
      "default": "120K ratings",
      "maxLength": 24
    }
  ],
  "elements": [
    {
      "type": "text",
      "id": "headline",
      "text": "{{headline}}",
      "font": "display",
      "align": "center",
      "color": "$foreground",
      "x": 80,
      "y": 330,
      "width": 920,
      "height": 420,
      "size": 120,
      "minSize": 80,
      "weight": 800,
      "lineHeight": 1,
      "letterSpacing": -0.04,
      "verticalAlign": "bottom",
      "maxLines": 3
    },
    {
      "type": "imageSlot",
      "id": "app-icon",
      "key": "appIcon",
      "x": 420,
      "y": 860,
      "width": 240,
      "height": 240,
      "radius": 58,
      "fit": "cover",
      "shadow": {
        "y": 24,
        "blur": 50,
        "color": "rgba(22, 19, 31, 0.3)"
      },
      "monogram": {
        "text": "{{appName}}",
        "fill": "$accent",
        "color": "#FFFFFF"
      }
    },
    {
      "type": "text",
      "id": "app-name",
      "text": "{{appName}}",
      "font": "display",
      "align": "center",
      "color": "$foreground",
      "x": 90,
      "y": 1130,
      "width": 900,
      "height": 90,
      "size": 64,
      "minSize": 44,
      "weight": 800,
      "letterSpacing": -0.03,
      "verticalAlign": "middle",
      "maxLines": 1
    },
    {
      "type": "text",
      "id": "cta",
      "text": "{{ctaLabel}}",
      "font": "sans",
      "align": "center",
      "color": "$background",
      "x": 190,
      "y": 1290,
      "width": 700,
      "height": 150,
      "size": 52,
      "minSize": 40,
      "weight": 800,
      "verticalAlign": "middle",
      "maxLines": 1,
      "pill": {
        "fill": "$foreground",
        "paddingX": 64,
        "paddingY": 34,
        "radius": 999
      }
    },
    {
      "type": "rating",
      "id": "rating",
      "x": 140,
      "y": 1510,
      "width": 800,
      "height": 64,
      "score": "{{ratingScore}}",
      "label": "{{ratingLabel}}",
      "color": "$foreground",
      "starColor": "$foreground"
    }
  ]
}
