{
  "id": "zoom",
  "canvas": {
    "width": 1080,
    "height": 1920
  },
  "variables": [
    {
      "key": "headline",
      "label": "Headline",
      "default": "Your app, beautifully presented",
      "perSlide": true,
      "maxLength": 48
    },
    {
      "key": "description",
      "label": "Description",
      "default": "",
      "perSlide": true,
      "multiline": true,
      "maxLength": 90
    }
  ],
  "elements": [
    {
      "type": "text",
      "id": "headline",
      "text": "{{headline}}",
      "font": "display",
      "size": 112,
      "minSize": 72,
      "weight": 800,
      "lineHeight": 1,
      "letterSpacing": -0.035,
      "align": "left",
      "verticalAlign": "bottom",
      "color": "$foreground",
      "maxLines": 3,
      "x": 90,
      "y": 130,
      "width": 900,
      "height": 320
    },
    {
      "type": "text",
      "id": "description",
      "text": "{{description}}",
      "font": "sans",
      "size": 38,
      "minSize": 30,
      "weight": 500,
      "lineHeight": 1.32,
      "align": "left",
      "verticalAlign": "top",
      "color": "$foreground",
      "opacity": 0.78,
      "maxLines": 2,
      "x": 90,
      "y": 474,
      "width": 800,
      "height": 104
    },
    {
      "type": "screenshot",
      "id": "shot",
      "slot": 0,
      "fit": "cover",
      "align": "top",
      "device": "phone",
      "placeholderColor": "$surface",
      "shadow": {
        "x": 24,
        "y": 60,
        "blur": 120,
        "color": "rgba(22, 19, 31, 0.35)"
      },
      "x": 170,
      "y": 640,
      "width": 1000,
      "height": 2170,
      "radius": 96,
      "rotation": -8
    }
  ]
}
