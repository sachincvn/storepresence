{
  "id": "pop-duo",
  "canvas": {
    "width": 1080,
    "height": 1920
  },
  "variables": [
    {
      "key": "headline",
      "label": "Headline",
      "default": "Your app, beautifully presented",
      "perSlide": true,
      "maxLength": 48
    },
    {
      "key": "description",
      "label": "Description",
      "default": "",
      "perSlide": true,
      "multiline": true,
      "maxLength": 90
    }
  ],
  "elements": [
    {
      "type": "text",
      "id": "headline",
      "text": "{{headline}}",
      "font": "display",
      "size": 104,
      "minSize": 68,
      "weight": 800,
      "lineHeight": 1,
      "letterSpacing": -0.035,
      "align": "center",
      "verticalAlign": "bottom",
      "color": "$foreground",
      "maxLines": 3,
      "x": 80,
      "y": 140,
      "width": 920,
      "height": 310
    },
    {
      "type": "text",
      "id": "description",
      "text": "{{description}}",
      "font": "sans",
      "size": 38,
      "minSize": 30,
      "weight": 500,
      "lineHeight": 1.32,
      "align": "center",
      "verticalAlign": "top",
      "color": "$foreground",
      "opacity": 0.78,
      "maxLines": 2,
      "x": 140,
      "y": 474,
      "width": 800,
      "height": 104
    },
    {
      "type": "screenshot",
      "id": "shot",
      "slot": 0,
      "fit": "cover",
      "align": "top",
      "device": "phone",
      "placeholderColor": "$surface",
      "shadow": {
        "y": 50,
        "blur": 100,
        "color": "rgba(22, 19, 31, 0.35)"
      },
      "x": 250,
      "y": 690,
      "width": 580,
      "height": 1257,
      "radius": 56
    },
    {
      "type": "callout",
      "id": "callout",
      "slot": 0,
      "style": "card",
      "padding": 16,
      "radius": 44,
      "shadow": {
        "y": 34,
        "blur": 80,
        "color": "rgba(22, 19, 31, 0.32)"
      },
      "region": {
        "x": 0.03,
        "y": 0.182,
        "w": 0.94,
        "h": 0.102
      },
      "x": 70,
      "y": 840,
      "width": 700,
      "height": 330,
      "rotation": -3
    },
    {
      "type": "callout",
      "id": "callout-2",
      "slot": 0,
      "style": "card",
      "padding": 16,
      "radius": 44,
      "shadow": {
        "y": 34,
        "blur": 80,
        "color": "rgba(22, 19, 31, 0.32)"
      },
      "region": {
        "x": 0.03,
        "y": 0.471,
        "w": 0.94,
        "h": 0.102
      },
      "x": 310,
      "y": 1330,
      "width": 700,
      "height": 330,
      "rotation": 3
    }
  ]
}
