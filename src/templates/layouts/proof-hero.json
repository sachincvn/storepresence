{
  "id": "proof-hero",
  "canvas": {
    "width": 1080,
    "height": 1920
  },
  "variables": [
    {
      "key": "laurelTitle",
      "label": "Award title",
      "default": "Loved by millions",
      "maxLength": 24
    },
    {
      "key": "laurelSubtitle",
      "label": "Award subtitle",
      "default": "Top rated",
      "maxLength": 28
    },
    {
      "key": "headline",
      "label": "Headline",
      "default": "Your app, beautifully presented",
      "perSlide": true,
      "maxLength": 48
    },
    {
      "key": "ratingScore",
      "label": "Rating",
      "default": "4.9",
      "maxLength": 4
    },
    {
      "key": "ratingLabel",
      "label": "Rating label",
      "default": "120K ratings",
      "maxLength": 24
    }
  ],
  "elements": [
    {
      "type": "laurels",
      "id": "laurels",
      "x": 110,
      "y": 70,
      "width": 860,
      "height": 350,
      "title": "{{laurelTitle}}",
      "subtitle": "{{laurelSubtitle}}",
      "stars": true,
      "color": "$foreground"
    },
    {
      "type": "text",
      "id": "headline",
      "text": "{{headline}}",
      "font": "display",
      "size": 92,
      "minSize": 64,
      "weight": 800,
      "lineHeight": 1,
      "letterSpacing": -0.035,
      "align": "center",
      "verticalAlign": "top",
      "color": "$foreground",
      "maxLines": 2,
      "x": 80,
      "y": 430,
      "width": 920,
      "height": 210
    },
    {
      "type": "rating",
      "id": "rating",
      "x": 140,
      "y": 660,
      "width": 800,
      "height": 64,
      "score": "{{ratingScore}}",
      "label": "{{ratingLabel}}",
      "color": "$foreground",
      "starColor": "$foreground"
    },
    {
      "type": "screenshot",
      "id": "shot",
      "slot": 0,
      "fit": "cover",
      "align": "top",
      "device": "phone",
      "placeholderColor": "$surface",
      "shadow": {
        "y": 50,
        "blur": 100,
        "color": "rgba(22, 19, 31, 0.35)"
      },
      "x": 235,
      "y": 800,
      "width": 610,
      "height": 1325,
      "radius": 60
    }
  ]
}
