{
  "id": "brand-hero",
  "canvas": {
    "width": 1080,
    "height": 1920
  },
  "variables": [
    {
      "key": "appName",
      "label": "App name",
      "default": "Taskly",
      "maxLength": 24
    },
    {
      "key": "headline",
      "label": "Headline",
      "default": "Your app, beautifully presented",
      "perSlide": true,
      "maxLength": 48
    },
    {
      "key": "ratingScore",
      "label": "Rating",
      "default": "4.9",
      "maxLength": 4
    },
    {
      "key": "ratingLabel",
      "label": "Rating label",
      "default": "120K ratings",
      "maxLength": 24
    }
  ],
  "elements": [
    {
      "type": "imageSlot",
      "id": "app-icon",
      "key": "appIcon",
      "x": 430,
      "y": 96,
      "width": 220,
      "height": 220,
      "radius": 52,
      "fit": "cover",
      "shadow": {
        "y": 24,
        "blur": 50,
        "color": "rgba(22, 19, 31, 0.3)"
      },
      "monogram": {
        "text": "{{appName}}",
        "fill": "$accent",
        "color": "#FFFFFF"
      }
    },
    {
      "type": "text",
      "id": "app-name",
      "text": "{{appName}}",
      "x": 90,
      "y": 344,
      "width": 900,
      "height": 84,
      "font": "display",
      "size": 60,
      "minSize": 40,
      "weight": 800,
      "letterSpacing": -0.03,
      "align": "center",
      "verticalAlign": "middle",
      "color": "$foreground",
      "maxLines": 1
    },
    {
      "type": "text",
      "id": "headline",
      "text": "{{headline}}",
      "font": "display",
      "size": 84,
      "minSize": 60,
      "weight": 700,
      "lineHeight": 1,
      "letterSpacing": -0.035,
      "align": "center",
      "verticalAlign": "top",
      "color": "$foreground",
      "maxLines": 2,
      "x": 80,
      "y": 452,
      "width": 920,
      "height": 196
    },
    {
      "type": "rating",
      "id": "rating",
      "x": 140,
      "y": 666,
      "width": 800,
      "height": 56,
      "score": "{{ratingScore}}",
      "label": "{{ratingLabel}}",
      "color": "$foreground",
      "starColor": "$foreground"
    },
    {
      "type": "screenshot",
      "id": "shot",
      "slot": 0,
      "fit": "cover",
      "align": "top",
      "device": "phone",
      "placeholderColor": "$surface",
      "shadow": {
        "y": 50,
        "blur": 100,
        "color": "rgba(22, 19, 31, 0.35)"
      },
      "x": 235,
      "y": 790,
      "width": 610,
      "height": 1325,
      "radius": 60
    },
    {
      "type": "imageSlot",
      "id": "mascot",
      "key": "mascot",
      "x": 640,
      "y": 1280,
      "width": 420,
      "height": 500,
      "fit": "contain",
      "shadow": {
        "y": 24,
        "blur": 40,
        "color": "rgba(22, 19, 31, 0.3)"
      }
    }
  ]
}
