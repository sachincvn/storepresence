{
  "id": "fresh-mint",
  "name": "Fresh Mint",
  "category": "Minimal",
  "description": "Airy and calm: white phones, soft mint light.",
  "canvas": {
    "width": 1080,
    "height": 1920
  },
  "theme": {
    "background": "#F2FBF6",
    "foreground": "#10231A",
    "primary": "#2E7D5B",
    "accent": "#3D5AFE",
    "surface": "#FFFFFF"
  },
  "editableColors": [
    "background",
    "accent"
  ],
  "background": {
    "type": "solid",
    "color": "$background"
  },
  "overrides": {
    "shot": {
      "frameColor": "#FFFFFF",
      "shadow": {
        "y": 40,
        "blur": 90,
        "color": "rgba(16, 35, 26, 0.18)"
      }
    },
    "shot-back": {
      "frameColor": "#FFFFFF",
      "shadow": {
        "y": 40,
        "blur": 90,
        "color": "rgba(16, 35, 26, 0.18)"
      }
    },
    "badge": {
      "color": "#FFFFFF",
      "pill": {
        "fill": "$accent",
        "paddingX": 36,
        "paddingY": 20
      }
    }
  },
  "panorama": [
    {
      "type": "shape",
      "id": "mint-1",
      "shape": "circle",
      "x": 380,
      "y": 1050,
      "width": 950,
      "height": 950,
      "fill": "#7FDDB4",
      "blur": 150,
      "opacity": 0.85
    },
    {
      "type": "shape",
      "id": "sky-1",
      "shape": "circle",
      "x": 1380,
      "y": -240,
      "width": 820,
      "height": 820,
      "fill": "#CFE3FF",
      "blur": 150,
      "opacity": 0.9
    },
    {
      "type": "shape",
      "id": "mint-2",
      "shape": "circle",
      "x": 2380,
      "y": 1150,
      "width": 900,
      "height": 900,
      "fill": "#7FDDB4",
      "blur": 150,
      "opacity": 0.8
    },
    {
      "type": "shape",
      "id": "sky-2",
      "shape": "circle",
      "x": 3420,
      "y": 200,
      "width": 860,
      "height": 860,
      "fill": "#CFE3FF",
      "blur": 150,
      "opacity": 0.9
    }
  ],
  "slides": [
    {
      "layout": "badge-hero",
      "defaults": {
        "badge": "New: Smart lists",
        "headline": "Plan your day in seconds",
        "description": "Every task sorted by what matters most."
      }
    },
    {
      "layout": "phone-center",
      "defaults": {
        "headline": "See your progress grow",
        "description": "Clear stats that keep you going."
      }
    },
    {
      "layout": "duo",
      "defaults": {
        "headline": "Stay in sync with your team",
        "description": "Chat and share without switching apps."
      }
    },
    {
      "layout": "text-bottom",
      "defaults": {
        "headline": "Never miss a deadline",
        "description": "Smart reminders, right on time."
      }
    }
  ]
}
