{
  "id": "playful-learning",
  "name": "Playful Learning",
  "category": "Playful",
  "description": "Grass green and sunny yellow with soft light, chat-bubble pop-outs and big stats.",
  "canvas": {
    "width": 1080,
    "height": 1920
  },
  "theme": {
    "background": "#2BA84A",
    "foreground": "#FFFFFF",
    "primary": "#1C7A35",
    "accent": "#FFC93C",
    "surface": "#FFFFFF"
  },
  "editableColors": [
    "background",
    "accent"
  ],
  "background": {
    "type": "linear",
    "angle": 180,
    "stops": [
      {
        "color": "$background",
        "at": 0
      },
      {
        "color": "$primary",
        "at": 1
      }
    ]
  },
  "grain": 0.05,
  "overrides": {
    "headline": {
      "weight": 800,
      "letterSpacing": -0.035,
      "emphasis": {
        "color": "$accent"
      },
      "marker": "$primary"
    },
    "shot": {
      "device": "phone-island",
      "frameColor": "#15402A",
      "shadow": {
        "y": 26,
        "blur": 0,
        "color": "rgba(14, 64, 32, 0.55)"
      }
    },
    "callout": {
      "style": "bubble",
      "radius": 52,
      "padding": 18,
      "shadow": {
        "y": 16,
        "blur": 0,
        "color": "rgba(14, 64, 32, 0.5)"
      }
    },
    "callout-2": {
      "style": "bubble",
      "radius": 52,
      "padding": 18,
      "shadow": {
        "y": 16,
        "blur": 0,
        "color": "rgba(14, 64, 32, 0.5)"
      }
    },
    "app-icon": {
      "monogram": {
        "text": "{{appName}}",
        "fill": "#FFFFFF",
        "color": "$primary"
      },
      "shadow": {
        "y": 18,
        "blur": 0,
        "color": "rgba(14, 64, 32, 0.5)"
      }
    },
    "rating": {
      "starColor": "$accent"
    },
    "stat": {
      "color": "$accent"
    }
  },
  "panorama": [
    {
      "type": "shape",
      "id": "sun-1",
      "shape": "circle",
      "x": 620,
      "y": 1260,
      "width": 960,
      "height": 960,
      "fill": "$accent",
      "blur": 210,
      "opacity": 0.4
    },
    {
      "type": "shape",
      "id": "light-1",
      "shape": "circle",
      "x": 1820,
      "y": -340,
      "width": 960,
      "height": 960,
      "fill": "#FFFFFF",
      "blur": 200,
      "opacity": 0.22
    },
    {
      "type": "shape",
      "id": "mint-1",
      "shape": "circle",
      "x": 2820,
      "y": 1260,
      "width": 960,
      "height": 960,
      "fill": "#7CF2A8",
      "blur": 210,
      "opacity": 0.4
    },
    {
      "type": "shape",
      "id": "sun-2",
      "shape": "circle",
      "x": 3780,
      "y": -200,
      "width": 880,
      "height": 880,
      "fill": "$accent",
      "blur": 210,
      "opacity": 0.3
    },
    {
      "type": "shape",
      "id": "ring-1",
      "shape": "circle",
      "x": 1460,
      "y": 880,
      "width": 1460,
      "height": 1460,
      "fill": "transparent",
      "stroke": {
        "color": "rgba(255,255,255,0.16)",
        "width": 3
      }
    }
  ],
  "slides": [
    {
      "layout": "brand-hero",
      "defaults": {
        "headline": "Plan your day in **5 minutes**"
      }
    },
    {
      "layout": "pop-out",
      "defaults": {
        "headline": "Build streaks that **stick**",
        "description": "Tiny daily wins add up fast."
      },
      "overrides": {
        "callout": {
          "region": {
            "x": 0.035,
            "y": 0.44,
            "w": 0.93,
            "h": 0.16
          },
          "tail": "bottom",
          "tailAt": 0.7
        }
      }
    },
    {
      "layout": "pop-duo",
      "defaults": {
        "headline": "Cheer each other **on**",
        "description": "Your crew, right inside the app."
      },
      "overrides": {
        "callout": {
          "region": {
            "x": 0.03,
            "y": 0.186,
            "w": 0.74,
            "h": 0.095
          },
          "tail": "bottom",
          "tailAt": 0.18
        },
        "callout-2": {
          "region": {
            "x": 0.23,
            "y": 0.286,
            "w": 0.74,
            "h": 0.095
          },
          "tail": "bottom",
          "tailAt": 0.82
        }
      }
    },
    {
      "layout": "stat-hero",
      "defaults": {
        "statValue": "9 days",
        "statLabel": "average streak",
        "headline": "Small steps, **big** wins"
      }
    }
  ]
}
