{
  "id": "lilac-clay",
  "name": "Lilac Mist",
  "category": "Soft",
  "description": "Soft lilac gradient with pastel light drifting across the set.",
  "canvas": {
    "width": 1080,
    "height": 1920
  },
  "theme": {
    "background": "#CDBDFF",
    "foreground": "#16131F",
    "primary": "#3D5AFE",
    "accent": "#FF8FC0",
    "surface": "#F3F4F6"
  },
  "editableColors": [
    "background",
    "accent"
  ],
  "background": {
    "type": "linear",
    "angle": 180,
    "stops": [
      {
        "color": "#F4F0FF",
        "at": 0
      },
      {
        "color": "$background",
        "at": 1
      }
    ]
  },
  "grain": 0.04,
  "overrides": {
    "shot": {
      "shadow": {
        "y": 50,
        "blur": 100,
        "color": "rgba(76, 46, 150, 0.35)"
      }
    },
    "shot-back": {
      "shadow": {
        "y": 40,
        "blur": 80,
        "color": "rgba(76, 46, 150, 0.3)"
      }
    },
    "badge": {
      "color": "$foreground",
      "pill": {
        "fill": "#FFFFFF",
        "paddingX": 36,
        "paddingY": 20
      }
    },
    "headline": {
      "emphasis": {
        "color": "$primary"
      },
      "marker": "#FFFFFF"
    }
  },
  "panorama": [
    {
      "type": "shape",
      "id": "rose-1",
      "shape": "circle",
      "x": 380,
      "y": 1180,
      "width": 1050,
      "height": 1050,
      "fill": "$accent",
      "blur": 190,
      "opacity": 0.5
    },
    {
      "type": "shape",
      "id": "light-1",
      "shape": "circle",
      "x": 1640,
      "y": -360,
      "width": 980,
      "height": 980,
      "fill": "#FFFFFF",
      "blur": 180,
      "opacity": 0.85
    },
    {
      "type": "shape",
      "id": "blue-1",
      "shape": "circle",
      "x": 2360,
      "y": 1260,
      "width": 980,
      "height": 980,
      "fill": "$primary",
      "blur": 210,
      "opacity": 0.18
    },
    {
      "type": "shape",
      "id": "rose-2",
      "shape": "circle",
      "x": 3420,
      "y": 120,
      "width": 940,
      "height": 940,
      "fill": "$accent",
      "blur": 190,
      "opacity": 0.42
    },
    {
      "type": "shape",
      "id": "ring-1",
      "shape": "circle",
      "x": 1500,
      "y": 980,
      "width": 1300,
      "height": 1300,
      "fill": "transparent",
      "stroke": {
        "color": "rgba(255,255,255,0.7)",
        "width": 3
      }
    }
  ],
  "slides": [
    {
      "layout": "phone-tilt",
      "defaults": {
        "headline": "Plan your day in **seconds**",
        "description": "Every task sorted by what matters most."
      }
    },
    {
      "layout": "phone-center",
      "defaults": {
        "headline": "See your progress ==grow==",
        "description": "Clear stats that keep you going."
      }
    },
    {
      "layout": "duo",
      "defaults": {
        "headline": "Stay in sync with your **team**",
        "description": "Chat and share without switching apps."
      }
    },
    {
      "layout": "badge-hero",
      "defaults": {
        "badge": "Never late again",
        "headline": "Never miss a ==deadline==",
        "description": "Smart reminders, right on time."
      }
    }
  ]
}
